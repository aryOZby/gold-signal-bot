# Telegram (https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# Optional: chat that receives daily/monthly Excel files and alerts
TELEGRAM_ADMIN_CHAT_ID=

# Optional: override chat ids from config.yaml
# TELEGRAM_GROUP_A_CHAT_ID=
# TELEGRAM_GROUP_B_CHAT_ID=


# MT5 — only needed for executor: mt5_native (Windows)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=

# Trading
LOT_SIZE=0.01
DRY_RUN=true

# Email — הדוח החודשי נשלח ב-01 לחודש. השאר ריק כדי לכבות.
# ב-Gmail חובה App Password (לא סיסמת החשבון): myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
