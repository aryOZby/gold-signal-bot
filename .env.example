# ─── Gold Signal Bot — environment ───────────────────────────────
# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).

# Telegram user API — https://my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# International format, e.g. +9725XXXXXXXX (used once by scripts/login_telegram.py)
TELEGRAM_PHONE=

# Optional: chat that receives alerts, the daily digest and report files
TELEGRAM_ADMIN_CHAT_ID=

# Optional: override group chat ids from config.yaml
# TELEGRAM_GROUP_A_CHAT_ID=
# TELEGRAM_GROUP_B_CHAT_ID=

# MetaTrader 5 — only for broker.type: mt5_native (Windows)
# Leave login/password/server empty to attach to the already-logged-in terminal.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# e.g. C:\Program Files\MetaTrader 5\terminal64.exe
MT5_TERMINAL_PATH=

# Trading
LOT_SIZE=0.01
# true = simulate only, no real orders. Keep true until tested on a demo account.
DRY_RUN=true

# Email — monthly report on the 1st of the month. Leave SMTP_USER empty to disable.
# Gmail requires an App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Comma-separated list
EMAIL_TO=
